# Copy this file to .env.local and paste your key from https://console.groq.com/keys
# The key is only read by the server (API routes). Never commit .env.local.
GROQ_API_KEY=

# Firebase (Google sign-in + saved chats). Public web config from
# Firebase console > Project settings > Your apps. Leave empty to run without accounts.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
